{
  "name": "@oktamax/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only 'View' dialogs, an API console, dark mode and an on-page assistant (hosted or on-device) for the Okta admin console.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/pyodide.mjs --if-missing && vp dev",
    "build": "node scripts/pyodide.mjs --if-missing && vp build",
    "icons": "node scripts/icons.mjs",
    "endpoints": "node scripts/endpoints.mjs",
    "bodies": "node scripts/bodies.mjs",
    "pyodide": "node scripts/pyodide.mjs",
    "check": "vp check",
    "test": "vp test",
    "evals": "vpx evals/run.ts",
    "screenshots": "npm run build && vpx e2e/screenshots.ts",
    "store-assets": "vpx e2e/storeAssets.ts",
    "test:e2e": "npm run build && vpx e2e/smoke.ts && vpx e2e/chat.ts && vpx e2e/onDevice.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p e2e && tsc --noEmit -p evals"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.102",
    "@ai-sdk/react": "^4.0.182",
    "@assistant-ui/react": "^0.15.37",
    "@assistant-ui/react-ai-sdk": "^1.4.24",
    "@assistant-ui/react-markdown": "^0.14.26",
    "@browser-ai/core": "^3.0.4",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@oktamax/shared": "*",
    "ai": "^7.0.178",
    "pyodide": "^314.0.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@hono/node-server": "^2.1.11",
    "@oktamax/server": "*",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0",
    "yaml": "^2.9.1"
  }
}
