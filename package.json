{
  "name": "oktamax",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension: read-only 'View' dialogs in the Okta admin console where the Edit button is missing.",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "icons": "node scripts/icons.mjs",
    "endpoints": "node scripts/endpoints.mjs",
    "check": "vp check",
    "test": "vp test",
    "test:e2e": "vp build && vpx e2e/smoke.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p e2e"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "$vite"
  }
}
