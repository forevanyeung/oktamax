{
  "name": "oktamax",
  "private": true,
  "workspaces": [
    "extension",
    "server",
    "shared"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "vp check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @oktamax/extension",
    "dev": "npm run dev -w @oktamax/server",
    "dev:extension": "npm run dev -w @oktamax/extension"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "vite": "$vite"
  }
}
