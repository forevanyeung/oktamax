# The Okta org whose admins use this server (not the -admin URL).
OKTA_ORG_URL=https://acme.okta.com
# OIDC app (Native or SPA, PKCE, no secret) with the Okta API read scopes granted.
OKTA_CLIENT_ID=0oa...
# More orgs, each with its own app: <org url>=<client id>, separated by spaces.
# OKTA_ORGS=https://acme.oktapreview.com=0oa... https://acme-test.okta.com=0oa...

# Where MCP clients reach this server, for signing in to /mcp/<org host>. Defaults to the
# URL each request arrives on; set it when the server is behind a proxy.
# PUBLIC_URL=https://oktamax.example.com
# Signs the client IDs MCP clients register, so they keep working across restarts
# (any long random string, e.g. `openssl rand -base64 32`).
# OAUTH_SECRET=

# The model: Anthropic's API if ANTHROPIC_API_KEY is set, otherwise Bedrock.
# MODEL_ID defaults to claude-opus-5-5 on the API, us.anthropic.claude-opus-5-5 on Bedrock.
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL_ID=

# Bedrock. Credentials come from the standard AWS chain (env, SSO profile, role).
AWS_REGION=us-east-1

PORT=8787

# Okta's MCP server, run once per admin (needs `uv`; the Docker image preinstalls it).
# OKTA_MCP_COMMAND=uvx
# OKTA_MCP_ARGS=okta-mcp-server@1.1.7
# OKTA_MCP_IDLE_MINUTES=10
# OKTA_MCP_MAX_PROCESSES=50
# uv's package cache and Pythons, shared by admins' processes. Default: the server user's.
# UV_CACHE_DIR=/var/cache/uv
# UV_PYTHON_INSTALL_DIR=/var/lib/uv/python
