# The Okta org whose admins use this server (not the -admin URL).
OKTA_ORG_URL=https://acme.okta.com
# OIDC app (Native or SPA, PKCE, no secret) with the Okta API read scopes granted.
OKTA_CLIENT_ID=0oa...

# Bedrock. Credentials come from the standard AWS chain (env, SSO profile, role).
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-opus-5-5

PORT=8787

# Okta's MCP server, run once per admin (needs `uv`; the Docker image preinstalls it).
# OKTA_MCP_COMMAND=uvx
# OKTA_MCP_ARGS=okta-mcp-server@1.1.7
# OKTA_MCP_IDLE_MINUTES=10
# OKTA_MCP_MAX_PROCESSES=50
# Share one package cache between admins' processes.
# UV_CACHE_DIR=/var/cache/uv
